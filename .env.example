DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aidevt
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# LLM Configuration
# LLM_PROVIDER options: "openai", "fake"
# Use "fake" for local demo without API key
LLM_PROVIDER=fake

# Required when LLM_PROVIDER=openai
# LLM_API_KEY=sk-xxx

# Optional: Model name (default: gpt-4)
# LLM_MODEL=gpt-4-turbo-preview

# Optional: Custom base URL for OpenAI-compatible endpoints
# LLM_BASE_URL=https://api.openai.com/v1

# Optional: Request timeout in Go duration format (default: 60s)
# LLM_TIMEOUT=60s
