{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "ask",
    "bash": "ask"
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      ".next/**",
      ".git/**",
      "tmp/**",
      ".env",
      ".env.local"
    ]
  },
  "agent": {
    "leader": {
      "mode": "all",
      "permission": {
        "task": {
          "*": "deny",
          "database": "allow",
          "backend": "allow",
          "frontend": "allow",
          "qa": "allow",
          "reviewer": "allow"
        }
      }
    },
    "database": {
      "mode": "subagent"
    },
    "backend": {
      "mode": "subagent"
    },
    "frontend": {
      "mode": "subagent"
    },
    "qa": {
      "mode": "subagent",
      "permission": {
        "bash": "allow"
      }
    },
    "reviewer": {
      "mode": "subagent",
      "permission": {
        "edit": "deny"
      }
    }
  }
}
